# Frontend Environment Variables

# Local development - backend runs on port 5000 via Vite proxy
VITE_API_URL=http://localhost:5000

# Production on Render - routes in render.yaml proxy /api/* calls to backend
# Leave VITE_API_URL unset or empty in production; static site routes handle it
# VITE_API_URL=https://customer-service-backend.onrender.com
