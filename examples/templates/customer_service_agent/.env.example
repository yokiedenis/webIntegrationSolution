# Example environment variables for the Customer Service Agent
# Copy this file to `.env` and fill in real values locally. DO NOT commit your
# real `.env` file to version control. This file contains placeholders only.

# Groq API Key (set if using Groq provider)
GROQ_API_KEY=

# OpenAI API Key (optional fallback / alternative)
OPENAI_API_KEY=

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# Agent runtime settings
AGENT_MODEL=groq/llama3-8b
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=300

# Local-only overrides
PYTHON_PATH=python3
AGENT_PORT=5001
AGENT_SUBPROCESS_ENABLED=true

# Notes:
# - Replace the blank values with your secret keys locally and keep the
#   filled `.env` file out of version control.
# - If you use multiple environments, consider `.env.development`,
#   `.env.production` and add them to .gitignore as well.
